# syntax=docker/dockerfile:1
# Debug Dockerfile: builds with debug symbols and includes GDB in the final image.
# Usage:
#   docker buildx build -f Dockerfile.debug -t mumble-server:debug \
#     --build-context mumble-src=<path-to-repo> .
#
# Then run interactively:
#   docker run -it --cap-add=SYS_PTRACE --security-opt seccomp=unconfined \
#     mumble-server:debug

FROM ubuntu:24.04 AS base

ARG DEBIAN_FRONTEND=noninteractive
RUN sed -i 's|http://security.ubuntu.com|http://archive.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources \
  && apt-get -o Acquire::Check-Date=false update && apt-get install --no-install-recommends -y \
  ca-certificates \
  gdb \
  libavahi-compat-libdnssd1 \
  libcap2 \
  libqt6core6t64 \
  libqt6dbus6t64 \
  libqt6gui6t64 \
  libqt6network6t64 \
  libqt6sql6t64 \
  libqt6sql6-sqlite \
  libqt6xml6t64 \
  libzeroc-ice3.7t64 \
  '^libprotobuf[0-9]+t?64?$' \
  libsqlite3-0 \
  '^libmysqlclient[0-9]+$' \
  libpq5 \
  '^libpocofoundation[0-9]+t?64?$' \
  '^libpocodata[0-9]+t?64?$' \
  '^libpocojson[0-9]+t?64?$' \
  '^libpocoxml[0-9]+t?64?$' \
  '^libpoconet[0-9]+t?64?$' \
  '^libpoconetssl[0-9]+t?64?$' \
  '^libpococrypto[0-9]+t?64?$' \
  '^libpocojwt[0-9]+t?64?$' \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*


# Build the Rust WebRTC SFU shared library in its own stage.
FROM ubuntu:24.04 AS sfu-build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install --no-install-recommends -y \
  curl ca-certificates build-essential pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
COPY --from=mumble-src 3rdparty/webrtc-sfu /sfu
WORKDIR /sfu
RUN cargo build --release && strip target/release/libwebrtc_sfu.so


# Build the Rust mumble-plugin-host cdylib in its own stage. This produces
# libmumble_plugin_host.so plus the cbindgen-generated C header consumed by
# the C++ server build.
FROM ubuntu:24.04 AS plugin-host-build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install --no-install-recommends -y \
  curl ca-certificates build-essential pkg-config libssl-dev patchelf \
  && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
COPY --from=mumble-src 3rdparty/mumble-plugin-host /plugin-host
WORKDIR /plugin-host
RUN cargo build --release \
      -p mumble-plugin-host \
      -p mumble-file-server \
      -p mumble-live-doc \
 && patchelf --set-soname libmumble_plugin_host.so target/release/libmumble_plugin_host.so \
 && mkdir -p /plugin-host/plugins \
 && cp target/release/libmumble_file_server.so /plugin-host/plugins/ \
 && cp target/release/libmumble_live_doc.so   /plugin-host/plugins/


# ------------------------------------------------------------------
# Download the fancy-greeter plugin from GitHub Releases.
# Supports linux/amd64 and linux/arm64; other architectures skip
# silently (the plugins directory will just be empty for them).
# Override FANCY_PLUGIN_VERSION at build time to pin a specific release.
# ------------------------------------------------------------------
FROM ubuntu:24.04 AS plugin-fetch
ARG TARGETARCH
ARG FANCY_PLUGIN_VERSION=v0.2.0
RUN apt-get update && apt-get install --no-install-recommends -y curl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /plugins \
  && case "${TARGETARCH}" in \
       amd64) ARCHIVE="fancy-greeter-linux-x86_64.tar.gz" ;; \
       arm64) ARCHIVE="fancy-greeter-linux-aarch64.tar.gz" ;; \
       *)     echo "No fancy-greeter build for arch '${TARGETARCH}', skipping."; ARCHIVE="" ;; \
     esac \
  && if [ -n "${ARCHIVE}" ]; then \
       curl -fsSL "https://github.com/Fancy-Mumble/fancy-plugin-example/releases/download/${FANCY_PLUGIN_VERSION}/${ARCHIVE}" \
         | tar -xz -C /plugins; \
     fi


FROM base AS build
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get -o Acquire::Check-Date=false update && apt-get install --no-install-recommends -y \
  build-essential \
  ca-certificates \
  ccache \
  cmake \
  curl \
  ninja-build \
  gdb \
  git \
  libavahi-compat-libdnssd-dev \
  libboost-dev \
  libcap-dev \
  libprotoc-dev \
  libprotobuf-dev \
  libssl-dev \
  libxi-dev \
  libzeroc-ice-dev \
  libsqlite3-dev \
  libmysqlclient-dev \
  libpq-dev \
  libpoco-dev \
  pkg-config \
  protobuf-compiler \
  python3 \
  qt6-base-dev \
  qt6-tools-dev \
  qt6-tools-dev-tools \
  qt6-svg-dev \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

COPY --from=mumble-src . /mumble/repo
WORKDIR /mumble/repo

RUN git submodule update --init && git submodule update --depth 1

# Drop the prebuilt mumble-plugin-host artefacts where CMake expects them so
# the C++ link step can resolve the cdylib symbols.
COPY --from=plugin-host-build /plugin-host/target/release/libmumble_plugin_host.so \
    /mumble/repo/3rdparty/mumble-plugin-host/lib/libmumble_plugin_host.so
COPY --from=plugin-host-build /plugin-host/host/include/mumble_plugin_host.h \
    /mumble/repo/3rdparty/mumble-plugin-host/include/mumble_plugin_host.h

# Build with RelWithDebInfo for debug symbols + optimizations.
RUN --mount=type=cache,target=/root/.ccache,id=mumble-ccache-debug \
    cd /mumble/repo && \
    mkdir -p build-debug && cd build-debug && \
    cmake -G Ninja \
      -DCMAKE_BUILD_TYPE=RelWithDebInfo \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache \
      -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
      -DBUILD_NUMBER=0 \
      -Dclient=OFF \
      -Dserver=ON \
      -Dice=ON \
      -Dtests=ON \
      -Dwarnings-as-errors=ON \
      -Dzeroconf=OFF \
      -Dwebrtc-sfu=OFF \
      -DCMAKE_UNITY_BUILD=ON \
      .. && \
    cmake --build . -j $(nproc) && \
    cp /mumble/repo/build-debug/mumble-server /mumble/mumble-server && \
    (cp /mumble/repo/build-debug/src/murmur/fcm/libmumble_push_fcm.so /mumble/ 2>/dev/null || true)

RUN cp -f /mumble/repo/auxiliary_files/mumble-server.ini /mumble/default_config.ini 2>/dev/null \
    || cp -f /mumble/repo/scripts/murmur.ini /mumble/default_config.ini


FROM base
ARG MUMBLE_UID=1000
ARG MUMBLE_GID=1000
RUN getent group $MUMBLE_GID && groupdel $(getent group $MUMBLE_GID | cut -d: -f1) || true \
  && getent passwd $MUMBLE_UID && userdel $(getent passwd $MUMBLE_UID | cut -d: -f1) || true \
  && groupadd --gid $MUMBLE_GID mumble \
  && useradd --uid $MUMBLE_UID --gid $MUMBLE_GID mumble

# Do NOT strip - keep debug symbols in the binary.
COPY --from=build /mumble/mumble-server /usr/bin/mumble-server
# FCM push module is optional - only copied if built.
COPY --from=build /mumble/libmumble_push_fcm.so* /usr/bin/
# WebRTC SFU Rust module - built in the sfu-build stage.
COPY --from=sfu-build /sfu/target/release/libwebrtc_sfu.so /usr/bin/
# Mumble plugin host Rust cdylib - built in the plugin-host-build stage.
# Installed under the multiarch lib dir so the dynamic linker finds it via DT_NEEDED.
COPY --from=plugin-host-build /plugin-host/target/release/libmumble_plugin_host.so \
    /usr/lib/x86_64-linux-gnu/libmumble_plugin_host.so
# Built-in dynamic plugins (file-server, live-doc) - loaded at runtime via
# MUMBLE_PLUGIN_DIRS.  Operators may drop additional plugins into the mounted
# /etc/mumble/plugins directory.
COPY --from=plugin-host-build /plugin-host/plugins/ /usr/lib/mumble-server/plugins/
# Third-party plugins downloaded from GitHub Releases.
COPY --from=plugin-fetch /plugins/ /usr/lib/mumble-server/plugins/
COPY --from=build /mumble/default_config.ini /etc/mumble/bare_config.ini

RUN mkdir -p /data /etc/mumble/plugins \
 && chown -R mumble:mumble /data \
 && chown -R mumble:mumble /etc/mumble
ENV MUMBLE_PLUGIN_DIRS="/usr/lib/mumble-server/plugins:/etc/mumble/plugins"
EXPOSE 64738/tcp 64738/udp 64739/tcp 10000/udp
COPY entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/mumble-server", "-fg", "-v", "--ini", "/data/mumble_server_config.ini"]
