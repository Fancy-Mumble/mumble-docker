# syntax=docker/dockerfile:1
# Dev Dockerfile: uses local source + BuildKit cache for fast incremental rebuilds.
# Usage:
#   docker buildx build -f Dockerfile.dev -t mumble-server:dev \
#     --build-context mumble-src=F:\Dokumente\projekte\mumble_server\mumble-server .
#
# Requires DOCKER_BUILDKIT=1 (default in modern Docker).

FROM ubuntu:24.04 AS base

ARG DEBIAN_FRONTEND=noninteractive
RUN sed -i 's|http://security.ubuntu.com|http://archive.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources \
  && apt-get -o Acquire::Check-Date=false update && apt-get install --no-install-recommends -y \
  ca-certificates \
  libavahi-compat-libdnssd1 \
  libcap2 \
  libqt6core6t64 \
  libqt6dbus6t64 \
  libqt6network6t64 \
  libqt6sql6t64 \
  libqt6sql6-sqlite \
  libqt6xml6t64 \
  libzeroc-ice3.7t64 \
  '^libprotobuf[0-9]+t?64?$' \
  libsqlite3-0 \
  '^libmysqlclient[0-9]+$' \
  libpq5 \
  '^libpocofoundation[0-9]+t?64?$' \
  '^libpocodata[0-9]+t?64?$' \
  '^libpocojson[0-9]+t?64?$' \
  '^libpocoxml[0-9]+t?64?$' \
  '^libpoconet[0-9]+t?64?$' \
  '^libpoconetssl[0-9]+t?64?$' \
  '^libpococrypto[0-9]+t?64?$' \
  '^libpocojwt[0-9]+t?64?$' \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*


# Build the Rust WebRTC SFU shared library in its own stage.
FROM ubuntu:24.04 AS sfu-build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install --no-install-recommends -y \
  curl ca-certificates build-essential pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
COPY --from=mumble-src 3rdparty/webrtc-sfu /sfu
WORKDIR /sfu
RUN cargo build --release && strip target/release/libwebrtc_sfu.so

# Build the Rust mumble-plugin-host cdylib (file-server, etc.) in its own stage.
FROM ubuntu:24.04 AS plugin-host-build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install --no-install-recommends -y \
  curl ca-certificates build-essential pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
# Node.js 22 LTS (NodeSource): Ubuntu 24.04 ships Node 18, which is too old for
# the file-server web frontend's Vite build.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install --no-install-recommends -y nodejs \
 && rm -rf /var/lib/apt/lists/*
COPY --from=mumble-src 3rdparty/mumble-plugin-host /plugin-host
WORKDIR /plugin-host
# Build the embedded file-server web pages (React + MUI -> file-server/web/dist/
# password.html, embedded by the crate via include_str!) before the Rust build.
# MUMBLE_FILESERVER_SKIP_WEB_BUILD then tells the crate's build.rs to reuse this
# artifact instead of invoking npm a second time.
RUN npm --prefix file-server/web ci \
 && npm --prefix file-server/web run build
ENV MUMBLE_FILESERVER_SKIP_WEB_BUILD=1
RUN cargo build --release \
      -p mumble-plugin-host \
      -p mumble-file-server \
      -p mumble-live-doc \
      -p mumble-link-preview \
      -p mumble-calendar \
      -p mumble-friends \
      -p mumble-audit \
 && strip target/release/libmumble_plugin_host.so \
          target/release/libmumble_file_server.so \
          target/release/libmumble_live_doc.so \
          target/release/libmumble_link_preview.so \
          target/release/libmumble_calendar.so \
          target/release/libmumble_friends.so \
          target/release/libmumble_audit.so \
 && mkdir -p /plugin-host/plugins \
 && cp target/release/libmumble_file_server.so /plugin-host/plugins/ \
 && cp target/release/libmumble_live_doc.so   /plugin-host/plugins/ \
 && cp target/release/libmumble_link_preview.so /plugin-host/plugins/ \
 && cp target/release/libmumble_calendar.so   /plugin-host/plugins/ \
 && cp target/release/libmumble_friends.so    /plugin-host/plugins/ \
 && cp target/release/libmumble_audit.so      /plugin-host/plugins/


# ------------------------------------------------------------------
# Build the local fancy-plugin-example workspace (4 example plugin
# cdylibs) from a named build context.
#
# Requires `--build-context fancy-plugins-src=<path>` to point at the
# repo root of the fancy-plugin-example checkout.  The workspace's
# Cargo.toml path-deps assume a sibling `mumble-server/` directory, so
# we stage the mumble-plugin-host subtree of the local mumble-server
# checkout (`--from=mumble-src`) at the expected sibling location
# inside the builder.
# ------------------------------------------------------------------
FROM ubuntu:24.04 AS fancy-plugins-build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install --no-install-recommends -y \
  curl ca-certificates build-essential pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
# Sibling layout: fancy-plugin-example/Cargo.toml declares
#   mumble-plugin-api = { path = "../mumble-server/3rdparty/mumble-plugin-host/api" }
# so from /fancy-plugin-example, `..` must resolve to a directory that
# contains `mumble-server/3rdparty/mumble-plugin-host/`.
COPY --from=mumble-src 3rdparty/mumble-plugin-host /mumble-server/3rdparty/mumble-plugin-host
COPY --from=fancy-plugins-src . /fancy-plugin-example
WORKDIR /fancy-plugin-example
RUN cargo build --release --workspace \
 && strip target/release/libfancy_greeter.so \
          target/release/libfancy_gallery_showcase.so \
          target/release/libfancy_info_card.so \
          target/release/libfancy_feedback_form.so \
          target/release/libfancy_quick_poll.so \
          target/release/libfancy_chat_card.so \
 && mkdir -p /fancy-plugins \
 && cp target/release/libfancy_greeter.so \
       target/release/libfancy_gallery_showcase.so \
       target/release/libfancy_info_card.so \
       target/release/libfancy_feedback_form.so \
       target/release/libfancy_quick_poll.so \
       target/release/libfancy_chat_card.so \
       /fancy-plugins/


FROM base AS build
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get -o Acquire::Check-Date=false update && apt-get install --no-install-recommends -y \
  build-essential \
  ca-certificates \
  cmake \
  curl \
  ninja-build \
  gdb \
  git \
  libavahi-compat-libdnssd-dev \
  libboost-dev \
  libcap-dev \
  libprotoc-dev \
  libprotobuf-dev \
  libssl-dev \
  libxi-dev \
  libzeroc-ice-dev \
  libsqlite3-dev \
  libmysqlclient-dev \
  libpq-dev \
  libpoco-dev \
  pkg-config \
  protobuf-compiler \
  python3 \
  qt6-base-dev \
  qt6-tools-dev \
  qt6-tools-dev-tools \
  qt6-svg-dev \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Copy local source instead of cloning from GitHub.
# Use --from=mumble-src (a named build context pointing to the local repo).
COPY --from=mumble-src . /mumble/repo
WORKDIR /mumble/repo

# Initialize submodules (needed for 3rdparty deps).
# Cache the .git directory so repeated builds don't re-download submodules.
# Skip when the source is not a standalone git repo (e.g. a git *submodule*
# checkout like the e2e harness' vendor/server, whose .git is a dangling gitdir
# pointer): there the submodules are already vendored in the copied tree.
RUN if git rev-parse --git-dir >/dev/null 2>&1; then \
        git submodule update --init && git submodule update --depth 1; \
    else \
        echo "Skipping submodule update: source is not a standalone git repo; using vendored submodules."; \
    fi

# Drop the prebuilt mumble-plugin-host artefacts where CMake expects them so
# the C++ link step can resolve the cdylib symbols.
COPY --from=plugin-host-build /plugin-host/target/release/libmumble_plugin_host.so \
    /mumble/repo/3rdparty/mumble-plugin-host/lib/libmumble_plugin_host.so
COPY --from=plugin-host-build /plugin-host/host/include/mumble_plugin_host.h \
    /mumble/repo/3rdparty/mumble-plugin-host/include/mumble_plugin_host.h

# Build with a persistent CMake cache mount so only changed files recompile.
RUN --mount=type=cache,target=/mumble/repo/build,id=mumble-cmake-build \
    cd /mumble/repo && \
    mkdir -p build && cd build && \
    cmake -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_NUMBER=0 \
      -Dclient=OFF \
      -Dserver=ON \
      -Dice=ON \
      -Dtests=ON \
      -Dwarnings-as-errors=OFF \
      -Dzeroconf=OFF \
      -Dwebrtc-sfu=OFF \
      -DCMAKE_UNITY_BUILD=ON \
      .. && \
    cmake --build . -j $(nproc) && \
    cp /mumble/repo/build/mumble-server /mumble/mumble-server && \
    (cp /mumble/repo/build/src/murmur/fcm/libmumble_push_fcm.so /mumble/ 2>/dev/null || true)

# Run pchat regression tests
# QT_QPA_PLATFORM=offscreen lets the Qt-based test initialize without an X
# display (the build container has no DISPLAY / xcb).
RUN --mount=type=cache,target=/mumble/repo/build,id=mumble-cmake-build \
    cd /mumble/repo/build && \
    QT_QPA_PLATFORM=offscreen ctest --test-dir . -R TestPersistentChatManager --output-on-failure --no-tests=error

# Copy default config
RUN cp -f /mumble/repo/auxiliary_files/mumble-server.ini /mumble/default_config.ini 2>/dev/null \
    || cp -f /mumble/repo/scripts/murmur.ini /mumble/default_config.ini


FROM base
ARG MUMBLE_UID=1000
ARG MUMBLE_GID=1000
RUN getent group $MUMBLE_GID && groupdel $(getent group $MUMBLE_GID | cut -d: -f1) || true \
  && getent passwd $MUMBLE_UID && userdel $(getent passwd $MUMBLE_UID | cut -d: -f1) || true \
  && groupadd --gid $MUMBLE_GID mumble \
  && useradd --uid $MUMBLE_UID --gid $MUMBLE_GID mumble

COPY --from=build /mumble/mumble-server /usr/bin/mumble-server
# FCM push module is optional - only copied if built.
# The file is guaranteed to exist (empty or real) thanks to the touch in the build stage.
COPY --from=build /mumble/libmumble_push_fcm.so* /usr/bin/
# WebRTC SFU Rust module - built in the sfu-build stage.
COPY --from=sfu-build /sfu/target/release/libwebrtc_sfu.so /usr/bin/
# mumble-plugin-host Rust module - built in plugin-host-build stage.
COPY --from=plugin-host-build /plugin-host/target/release/libmumble_plugin_host.so /usr/lib/
# Built-in dynamic plugins (file-server, live-doc) - loaded at runtime via
# MUMBLE_PLUGIN_DIRS.  Operators can drop additional plugins into the mounted
# /etc/mumble/plugins directory.
COPY --from=plugin-host-build /plugin-host/plugins/ /usr/lib/mumble-server/plugins/
# Locally-built fancy-plugin-example cdylibs (greeter, gallery-showcase,
# info-card, feedback-form).
COPY --from=fancy-plugins-build /fancy-plugins/ /usr/lib/mumble-server/plugins/
COPY --from=build /mumble/default_config.ini /etc/mumble/bare_config.ini

RUN mkdir -p /data /etc/mumble/plugins \
 && chown -R mumble:mumble /data \
 && chown -R mumble:mumble /etc/mumble
ENV MUMBLE_PLUGIN_DIRS="/usr/lib/mumble-server/plugins:/etc/mumble/plugins"
USER mumble
EXPOSE 64738/tcp 64738/udp 64739/tcp 10000/udp
COPY entrypoint.sh /entrypoint.sh

VOLUME ["/data", "/etc/mumble/plugins"]
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/mumble-server", "--foreground"]
