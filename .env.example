# =============================================================================
# Sample environment file for the helper scripts in this repository.
#
# Copy this file to ".env" in the same directory and edit the values to match
# your environment.  The dev-*, vanilla-*, export-db, import-db and buildx
# scripts all read variables from .env when present and fall back to the
# defaults listed below.
#
# Lines starting with "#" are comments.  No spaces around "=".
# =============================================================================


# -----------------------------------------------------------------------------
# Local Mumble source checkout (used by dev-build / dev-debug only).
#
# Point this at a local clone of the mumble-server source tree you want to
# build.  Required for Dockerfile.dev and Dockerfile.debug, which copy the
# source via a BuildKit build context instead of cloning over the network.
# -----------------------------------------------------------------------------
#MUMBLE_SRC=C:\path\to\your\mumble-server


# -----------------------------------------------------------------------------
# Image / container names.
# -----------------------------------------------------------------------------
#MUMBLE_IMAGE=mumble-server
#MUMBLE_CONTAINER=mumble-server
#MUMBLE_DATA_VOLUME=mumble-data

# Tag suffix applied to the built image (e.g. "dev", "debug", "vanilla").
# Each script sets a sensible default; only set this if you want to override.
#MUMBLE_TAG=dev


# -----------------------------------------------------------------------------
# Published ports (host side).  Container side is fixed by the Dockerfile.
# -----------------------------------------------------------------------------
#MUMBLE_PORT=64738
#MUMBLE_FILESERVER_PORT=64739
#MUMBLE_SFU_PORT=10000


# -----------------------------------------------------------------------------
# Runtime UID / GID inside the container.
#
# Used by dev-debug (which runs the server under gdb without su-exec) and by
# any script that needs to chown the data volume.  Must match the ownership
# of any host-mounted files.  Defaults to 1000:1000.
# -----------------------------------------------------------------------------
#MUMBLE_UID=1000
#MUMBLE_GID=1000


# -----------------------------------------------------------------------------
# Optional: SuperUser password.
#
# When set, the helper scripts will configure the server's SuperUser password
# after starting the container.  Leave empty / unset to skip; the server will
# generate a random one on first start (printed to the container log).
# -----------------------------------------------------------------------------
#MUMBLE_SUPERUSER_PASSWORD=


# -----------------------------------------------------------------------------
# Optional features.
#
# Each toggle below maps to a server .ini key and is forwarded to the
# container as a MUMBLE_CONFIG_* env var by the dev-build helper script.
# Disabled plugins are not loaded; the client UI hides the corresponding
# controls automatically.
#
# Set in production deployments via docker-compose `environment:` /
# `--env`.  The setup wizard writes these for you.
# -----------------------------------------------------------------------------
#MUMBLE_CONFIG_PLUGIN_FILE_SERVER_ENABLED=true
#MUMBLE_CONFIG_PUSHENABLED=false
#MUMBLE_CONFIG_WEBRTCSFUENABLED=false


# -----------------------------------------------------------------------------
# Optional: path to a local mumble-server.ini to mount into /data.
#
# When set and the file exists, the helper scripts mount it read-only at
# /data/mumble-server.ini and start the server with
# MUMBLE_CUSTOM_CONFIG_FILE pointing at it.  When unset, the entrypoint
# generates a config from MUMBLE_CONFIG_* environment variables instead.
# -----------------------------------------------------------------------------
#MUMBLE_INI=%~dp0mumble-server.ini


# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
#
# Two approaches for supplying FCM credentials:
#
# 1. Base64 env var / container secret (RECOMMENDED)
#    The entrypoint decodes the JSON at startup and writes it to a tmpfs
#    path (/tmp/fcm-credentials.json) that is never part of any image layer.
#    Generate with:
#        base64 -w 0 your-firebase-key.json   # Linux
#        [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))  # PowerShell
#    Or run the setup wizard — it encodes the file for you automatically.
#
#MUMBLE_FCM_CREDENTIALS_BASE64=<base64-encoded JSON>
#
# 2. Legacy file mount (for local dev scripts only)
#    The dev-build / dev-debug scripts mount this path read-only into the
#    container.  Suitable for local development; not recommended for
#    production because the file must exist on every host.
#
# NEVER commit this file or the base64 value to version control.
# Both patterns are gitignored.
# -----------------------------------------------------------------------------
#MUMBLE_FCM_CREDENTIALS=C:\path\to\your\fcm-credentials.json


# -----------------------------------------------------------------------------
# buildx.sh — multi-arch publish settings.
# -----------------------------------------------------------------------------
#BUILDX_IMAGE=yourorg/mumble-server:latest
#BUILDX_PLATFORMS=linux/amd64,linux/arm64


# -----------------------------------------------------------------------------
# Upstream source for the production Dockerfile (passed as build args).
#
# Defaults to the Fancy Mumble server fork.  Override to build from a
# different fork, branch, tag or commit.
#
# Companion repositories:
#   Server:  https://github.com/SetZero/mumble-server     (this image)
#   Client:  https://github.com/Fancy-Mumble/FancyMumbleNext
# -----------------------------------------------------------------------------
#MUMBLE_GIT_REPO=https://github.com/SetZero/mumble-server
#MUMBLE_GIT_BRANCH=1.6.x
