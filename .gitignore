# Local environment overrides
.env

# Local mumble server config - bootstrap from mumble-server.ini.example.
# The wizard patches this in place when MUMBLE_INI is set, so it shouldn't
# be committed.  The .example file is the committed reference template.
mumble-server.ini

# Local secrets - never commit
mumble*.json
fcm-credentials*.json
*-firebase-adminsdk*.json

# Local databases & backups
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.bak
db/

# Local build / debug logs
*.log

# Editor / IDE
.vscode/
.idea/
*.swp

# Python (setup wizard)
__pycache__/
*.pyc
.venv/
venv/

.claude/