; Sample Mumble server configuration for Docker.
;
; Copy this file to "mumble-server.ini" in the same directory and edit
; the values to match your deployment.  The setup wizard will also
; create / patch mumble-server.ini for you when MUMBLE_INI is set.
;
; mumble-server.ini is gitignored; this .example file is the committed
; reference template.
;
; Pass options via environment variables (MUMBLE_CONFIG_<OPTION>=<value>)
; or mount this file as a custom config with
; MUMBLE_CUSTOM_CONFIG_FILE=/data/mumble-server.ini.

; --------------------------------------------------------------------------
; Database
; --------------------------------------------------------------------------
database=/data/mumble-server.sqlite

; --------------------------------------------------------------------------
; Network
; --------------------------------------------------------------------------
port=64738
; host=

; --------------------------------------------------------------------------
; Server identity
; --------------------------------------------------------------------------
welcometext="<br />Welcome to this server running <b>Mumble</b>.<br />Enjoy your stay!<br />"
; serverpassword=
; registerName=Mumble Server

; --------------------------------------------------------------------------
; Limits
; --------------------------------------------------------------------------
users=100
; usersperchannel=0
bandwidth=558000
textmessagelength=500000
imagemessagelength=1048576
allowhtml=true

; --------------------------------------------------------------------------
; Security
; --------------------------------------------------------------------------
; certrequired=false
; sslCert=
; sslKey=

; --------------------------------------------------------------------------
; Logging
; --------------------------------------------------------------------------
; logdays=31
; obfuscate=false

; --------------------------------------------------------------------------
; Auto-ban
; --------------------------------------------------------------------------
autobanAttempts=0
; autobanTimeframe=120
; autobanTime=300

; --------------------------------------------------------------------------
; Persistent chat (Fancy Mumble encrypted message storage)
; --------------------------------------------------------------------------
pchatenabled=true
; pchatrequireregistration=false
; pchatdefaultmaxhistory=5000
; pchatdefaultretentiondays=90
; pchatmaxpayloadsize=1048576

; --------------------------------------------------------------------------
; Push notifications (FCM)
;
; The server loads a standalone shared library (libmumble_push_fcm.so) at
; startup to send push notifications via Firebase Cloud Messaging (FCM).
; If the library is absent or pushenabled is false, push is silently
; disabled and the server runs normally.
;
; To enable:
;   1. Obtain an FCM service-account JSON key from the Firebase console.
;   2. Mount the JSON key into the container (e.g. /data/fcm-credentials.json).
;   3. Set the options below.
;
; The library ships inside the Docker image at /usr/bin/libmumble_push_fcm.so
; (next to the server binary), so pushmodulepath is normally not needed.
; --------------------------------------------------------------------------
; Disabled by default.  Set pushprojectid to your Firebase project ID and
; pushcredentialspath to the mounted JSON key, then set pushenabled=true.
pushenabled=false
; pushmodulepath=
pushcredentialspath=/data/fcm-credentials.json
; pushprojectid=your-firebase-project-id
pushtopicprefix=mumble

; Which events trigger a push notification:
pushnotifytextmessage=true
pushnotifyreaction=false
pushnotifyuserjoin=false

; --------------------------------------------------------------------------
; WebRTC SFU (screen sharing relay)
; --------------------------------------------------------------------------
; The server loads a Rust shared library (libwebrtc_sfu.so) at startup to
; relay WebRTC screen-share streams.  If the library is absent or
; webrtcsfuenabled is false, screen sharing falls back to client-to-client
; signaling (no SFU relay).
;
; The library ships inside the Docker image at /usr/bin/libwebrtc_sfu.so
; (next to the server binary), so webrtcsfumodulepath is normally not needed.
; --------------------------------------------------------------------------
webrtcsfuenabled=false
; webrtcsfumodulepath=
webrtcsfuport=10000
; Public IP that clients should use to reach the SFU.  Must be reachable
; from each client.  Use 127.0.0.1 for local-only testing on the same
; host; the server's LAN / public IP otherwise.  0.0.0.0 is NOT valid -
; ICE rejects it as a candidate.
webrtcsfupublicip=127.0.0.1

; --------------------------------------------------------------------------
; Fancy Mumble file server (custom emotes, avatar uploads, etc.)
;
; The bundled mumble-file-server plugin reads these keys at startup.
; Values set via the admin UI or Ice RPC take precedence at runtime;
; the keys here are intended for deployment-time configuration.
;
; enabled       - Master toggle. Set to false to skip loading the plugin.
;                 The client UI hides the file-attach controls when no
;                 fancy-file-server-config message is received. Default: true.
; storagePath   - Absolute path where uploaded files are stored.
;                 There is no working default; the plugin will refuse to
;                 start until this is set to an absolute path.
; bindAddress   - Address the file-server HTTP listener binds to.
;                 Default: 127.0.0.1 (loopback, safe behind a reverse proxy).
;                 Set to 0.0.0.0 when exposing the port directly.
; port          - TCP port the file-server listens on. Default: 64739.
; iAmBehindATlsProxy - Must be true when bindAddress is not loopback.
; allowedOrigins     - Comma-separated CORS origins. Empty = block all.
; baseUrl            - Public URL clients use to reach the file server.
;                      If unset, clients fall back to http://<host>:<port>.
; --------------------------------------------------------------------------
plugin.file-server.enabled=true
plugin.file-server.storagePath=/data/file-server-storage
plugin.file-server.bindAddress=0.0.0.0
plugin.file-server.port=64739
plugin.file-server.tlsTerminatedByProxy=true
; plugin.file-server.allowedOrigins=
; plugin.file-server.baseUrl=

; --------------------------------------------------------------------------
; Live collaborative documents (Fancy Mumble 0.3.2+)
;
; The bundled mumble-live-doc plugin provides real-time collaborative
; documents over WebSocket using the Yjs CRDT protocol.  Clients send a
; FancyLiveDocOpen message (wire ID 141); the server replies with a
; FancyLiveDocInvite containing a short-lived JWT and WebSocket URL, then
; broadcasts a FancyLiveDocAnnounce to the rest of the channel.
;
; Without `enabled=true` AND a writable `state_path`, the plugin no-ops
; and clients will surface a timeout error after opening a document.
;
; enabled         - Master toggle.  Default: false.
; state_path      - Required absolute path for JWT signing key and room
;                   state.  The plugin refuses to start without this.
; host            - WebSocket listener bind address.  Default: 0.0.0.0.
; port            - WebSocket listener TCP port.  Default: 64740.
; public_url      - Base URL clients use to reach the WS endpoint.
;                   Required when terminated by a reverse proxy (e.g.
;                   "wss://chat.example.com/live-doc").
; --------------------------------------------------------------------------
; plugin.live-doc.enabled=false
plugin.live-doc.state_path=/data/live-doc-state
; plugin.live-doc.host=0.0.0.0
plugin.live-doc.port=64740
; plugin.live-doc.public_url=
; plugin.live-doc.max_update_bytes=4194304
; plugin.live-doc.snapshot_idle_secs=60
; plugin.live-doc.teardown_grace_secs=30
; plugin.live-doc.file_server_url=http://127.0.0.1:64739
; plugin.live-doc.file_server_admin_token=

; --------------------------------------------------------------------------
; Example / dev plugins (fancy-plugin-example workspace)
;
; All six example cdylibs are baked into the dev/debug images.
; Add the corresponding enabled=true line to load each one.
; --------------------------------------------------------------------------
; plugin.fancy-greeter.enabled=true
; plugin.fancy-gallery-showcase.enabled=true
; plugin.fancy-info-card.enabled=true
; plugin.fancy-feedback-form.enabled=true
; plugin.fancy-quick-poll.enabled=true
; plugin.fancy-chat-card.enabled=true

; --------------------------------------------------------------------------
; Ice RPC (must be last section)
; --------------------------------------------------------------------------
[Ice]
Ice.Warn.UnknownProperties=1
Ice.MessageSizeMax=65536
